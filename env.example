PORT=3000
NODE_ENV=development
# سلسلة عشوائية طويلة (32 حرفًا على الأقل): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# تُستخدم مرة واحدة مع npm run seed ثم احذفها من الملف
SEED_USERNAME=
SEED_PASSWORD=
BASE_URL=http://localhost:3000   # العنوان العام الذي يفتحه الطلاب (HTTPS في الإنتاج)
DB_PATH=attendance.db   # على الاستضافة: مسار داخل قرص دائم
LATE_AFTER_MINUTES=0   # مثال: 15 = من يسجّل بعد 15 دقيقة من البدء يصبح متأخرًا (0 = معطّل)
